# SPA fallback for React Router (Apache / LiteSpeed — Hostinger)
# Serves index.html for any path that isn't a real file or folder,
# so client-side routes like /submissions work on direct visit & refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
